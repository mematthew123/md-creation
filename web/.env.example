# Sanity project that stores Markdown Pages
NEXT_PUBLIC_SANITY_PROJECT_ID=5ouc347b
NEXT_PUBLIC_SANITY_DATASET=production
# Editor token, server-only. Create at sanity.io/manage -> API -> Tokens
SANITY_API_WRITE_TOKEN=

# Bearer secret for the manual trigger: POST /api/ingest
# openssl rand -hex 32
INGEST_SECRET=

# Vercel account webhook (Team Settings -> Webhooks). Secret is shown once.
VERCEL_WEBHOOK_SECRET=
# Project Settings -> General -> Project ID (prj_...)
VERCEL_PROJECT_ID=

# Canonical site origin, no trailing slash. Ingest fetches its own pages from here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deployed schema id for Agent Actions (`npx sanity schema list` in studio/)
SANITY_SCHEMA_ID=_.schemas.default
